<Window x:Class="PS2000Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS2000 Control"
        Height="520"
        Width="600">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="30"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Connection -->

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">

            <ComboBox x:Name="PortComboBox"
                    Width="120"
                    Margin="0,0,10,0"/>

            <Button Content="Refresh Ports"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="RefreshPortsButton_Click"/>

            <Button Content="Connect PS2000"
                    Width="130"
                    Click="ConnectButton_Click"/>
        </StackPanel>

        <!-- Device information -->

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Device Type:"
                   Margin="0,5"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   x:Name="DeviceTypeText"
                   Text="---"
                   Margin="0,5"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Serial Number:"
                   Margin="0,5"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   x:Name="SerialNumberText"
                   Text="---"
                   Margin="0,5"/>

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Article Number:"
                   Margin="0,5"/>

        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   x:Name="ArticleNumberText"
                   Text="---"
                   Margin="0,5"/>

        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Text="Maximum Voltage:"
                   Margin="0,5"/>

        <TextBlock Grid.Row="5"
                   Grid.Column="1"
                   x:Name="MaxVoltageText"
                   Text="--- V"
                   Margin="0,5"/>

        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Text="Current Voltage:"
                   Margin="0,5"/>

        <StackPanel Grid.Row="6"
                    Grid.Column="1"
                    Orientation="Horizontal">

            <TextBlock x:Name="CurrentVoltageText"
                       Text="--- V"
                       Width="100"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <Button Content="Refresh"
                    Width="100"
                    Click="RefreshVoltageButton_Click"/>

        </StackPanel>

        <!-- Set Voltage -->

        <TextBlock Grid.Row="8"
                   Grid.Column="0"
                   Text="Set Voltage:"
                   Margin="0,5"/>

        <StackPanel Grid.Row="8"
                    Grid.Column="1"
                    Orientation="Horizontal">

            <TextBox x:Name="VoltageInput"
                     Width="100"
                     Margin="0,0,10,0"/>

            <Button Content="Set Voltage"
                    Width="100"
                    Click="SetVoltageButton_Click"/>
        </StackPanel>

        <!-- Output -->

        <TextBlock Grid.Row="9"
                   Grid.Column="0"
                   Text="Power Output:"
                   Margin="0,5"/>

        <StackPanel Grid.Row="9"
                    Grid.Column="1"
                    Orientation="Horizontal">

            <Button Content="ON"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="OutputOnButton_Click"/>

            <Button Content="OFF"
                    Width="80"
                    Click="OutputOffButton_Click"/>
        </StackPanel>

        <!-- Remote Control -->

        <TextBlock Grid.Row="10"
                   Grid.Column="0"
                   Text="Remote Control:"
                   Margin="0,5"/>

        <StackPanel Grid.Row="10"
                    Grid.Column="1"
                    Orientation="Horizontal">

            <Button Content="ON"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="RemoteOnButton_Click"/>

            <Button Content="OFF"
                    Width="80"
                    Click="RemoteOffButton_Click"/>
        </StackPanel>

    </Grid>
</Window>